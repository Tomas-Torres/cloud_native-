# Copia este archivo a ".env" y completa con los valores del App
# Registration creado en Azure Portal -> Microsoft Entra ID -> App registrations.

# "Application (client) ID" del App Registration
VITE_AZURE_CLIENT_ID=

# "Directory (tenant) ID" del App Registration
VITE_AZURE_TENANT_ID=

# Redirect URI tipo SPA registrada en Azure. En desarrollo:
VITE_AZURE_REDIRECT_URI=http://localhost:5174

# Scope expuesto en "Expose an API" del App Registration.
# Formato: api://<CLIENT_ID>/<nombre-del-scope>
# Ej: api://11111111-2222-3333-4444-555555555555/access_as_admin
VITE_AZURE_API_SCOPE=
